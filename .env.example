# Copy to .env (git-ignored) for local runs of scripts/fetch-data.mjs.
# In GitHub the same names are repository secrets. Every key is optional:
# a source without its key is skipped and shown as not configured.

# https://aisstream.io (sign in with GitHub, then API Keys)
AISSTREAM_API_KEY=

# https://opensky-network.org (Account > API Client)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# https://developer.tomtom.com (free tier, 2,500 requests per day)
TOMTOM_API_KEY=

# https://developer.ticketmaster.com (Consumer Key of the default app)
TICKETMASTER_API_KEY=

# https://api.windy.com/keys (Webcams API, free tier)
WINDY_WEBCAMS_API_KEY=

# https://explore.openaq.org (account settings, API key)
OPENAQ_API_KEY=

# https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=

# https://transparency.entsoe.eu (register, then request "Restful API access"
# by e-mail; the token appears under My Account Settings)
ENTSOE_SECURITY_TOKEN=
